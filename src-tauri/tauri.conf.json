{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FastRead",
  "version": "0.1.0",
  "identifier": "com.emiliano.fastread",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "FastRead", "width": 1000, "height": 650 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
